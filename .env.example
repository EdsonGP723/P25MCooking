# Django Security
SECRET_KEY=tu-clave-secreta-django-aqui
DEBUG=True

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS - Orígenes permitidos desde el Frontend (React/Vite) separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-frontend.onrender.com
# Alternativa: permitir todos los orígenes si no se especifica CORS_ALLOWED_ORIGINS
# CORS_ALLOW_ALL_ORIGINS=True

# Base de Datos (PostgreSQL en Render o SQLite por defecto si está vacío)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Cloudinary (Almacenamiento de imágenes de recetas)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
